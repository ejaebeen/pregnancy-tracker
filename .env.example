# Copy to backend/.env (or export in your shell). .env is gitignored — never commit real secrets.

# SQLAlchemy connection string for the backend (dev defaults from docker-compose.yml)
DATABASE_URL=postgresql+psycopg2://tracker:tracker@localhost:5432/pregnancy_tracker

# Individual pieces, if you prefer composing the URL manually
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pregnancy_tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker

# Frontend: optional API base URL (empty = same-origin requests via the Vite dev proxy)
VITE_API_BASE=
